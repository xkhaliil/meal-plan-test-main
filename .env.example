# Copy to `.env` and fill in values. Do not commit real secrets to public repos.
# The README lists variables; this file shows the shape only.

# Postgres. A local server, a container, or a hosted branch (Neon, Supabase).
# In production use the POOLED connection string — every serverless
# invocation opens its own client.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mealplan"

# Where the integration tests may create and drop a throwaway schema.
# Unset, they fall back to DATABASE_URL when it is local, and are skipped
# otherwise.
TEST_DATABASE_URL=""

# Recipe Bot. Either provider works: an OpenAI key (sk-proj-...) talks to
# api.openai.com, an Anthropic key (sk-ant-...) is routed to Anthropic's
# OpenAI-compatible endpoint instead. lib/openai.ts picks the base URL and
# the model from the prefix.
OPENAI_API_KEY=""

# Stripe test mode (Dashboard → Developers → API keys)
STRIPE_RESTRICTED_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Absolute origin used for Stripe return URLs. Optional: the checkout route
# falls back to the request host, which is right on Vercel. Set it when you
# want every checkout to come back to the production domain rather than the
# preview URL it was started from.
NEXT_PUBLIC_APP_URL=""

# Pro subscription — see README (resolve price from product or pin a price).
STRIPE_PRO_PRODUCT_ID=""
STRIPE_PRICE_ID=""

JWT_SECRET="change-me"

# Google AI Studio / Gemini — recipe images, logo generation, chat image tooling where used
# GEMINI_API_KEY=
